							return PetController
							</ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX90">
						<Properties>
							<string name="Name">QuestController</string>
							<ProtectedString name="Source">-- EggHeist | Client/Controllers/QuestController.luau
							
							local QuestController = {}
							local ctx = nil
							
							function QuestController.Init(context)
							ctx = context
							end
							
							function QuestController.Claim(questId)
							ctx.Net.Fire("ClaimQuest", questId)
							end
							
							function QuestController.ClaimDaily()
							ctx.Net.Fire("ClaimDaily")
							end
							
							function QuestController.ClaimAchievement(achievementId)
