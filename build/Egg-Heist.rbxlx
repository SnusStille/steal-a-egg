	<Item class="SoundService" referent="RBX122">
		<Properties>
			<string name="Name">SoundService</string>
		</Properties>
	</Item>
	<Item class="Teams" referent="RBX123">
		<Properties>
			<string name="Name">Teams</string>
		</Properties>
	</Item>
